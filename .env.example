# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Primary Admin Contact Details & Credentials (Configured via Cloud Run environment secrets)
ADMIN_USERNAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PHONE=""
WHATSAPP_NUMBER=""

# Optional Email / SMTP Provider (e.g. Resend, SendGrid, Gmail SMTP) for real production enquiry notifications & OTP delivery
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""

# Optional SMS / OTP Provider (e.g. Twilio, MSG91) for production SMS OTP delivery
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
